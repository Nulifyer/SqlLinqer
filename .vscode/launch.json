{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SqlLinqer tests",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/SqlLinqer.Tests/bin/Debug/net10.0/SqlLinqer.Tests.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            // Use IntelliSense to find out which attributes exist for C# debugging
            // Use hover for the description of the existing attributes
            // For further information visit https://github.com/OmniSharp/omnisharp-vscode/blob/master/debugger-launchjson.md
            "name": "SqlLinqer .NET 10 tests (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-net10",
            // If you have changed target frameworks, make sure to update the program path.
            "program": "${workspaceFolder}/SqlLinqer.Tests.Net10/bin/Debug/net10.0/SqlLinqer.Tests.Net10.dll",
            "args": [],
            "cwd": "${workspaceFolder}/SqlLinqer.Tests.Net10",
            // For more information about the 'console' field, see https://aka.ms/VSCode-CS-LaunchJson-Console
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "SqlLinqer .NET Framework 4.8 tests (console)",
            "type": "clr",
            "request": "launch",
            "preLaunchTask": "build-netframework48",
            "program": "${workspaceFolder}/SqlLinqer.Tests.NetFramework48/bin/Debug/net48/SqlLinqer.Tests.NetFramework48.exe",
            "args": [],
            "cwd": "${workspaceFolder}/SqlLinqer.Tests.NetFramework48",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
