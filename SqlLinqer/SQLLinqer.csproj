<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Authors>Kyle Leddy</Authors>
    <Company></Company>
    <Description>Build parameterized SQL queries from C# model mappings and expressions. Supports typed selects, nested relationships, aggregates, writes, and synchronous or asynchronous execution.</Description>
    <Copyright></Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SignAssembly>false</SignAssembly>
    <PackageId>SqlLinqer</PackageId>
    <Product>SqlLinqer</Product>
    <Version>2.2.0-dev</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1591;CS1658;CS1711;CS1712;CS1734;CS1735</WarningsAsErrors>
    <RepositoryUrl>https://github.com/Nulifyer/SqlLinqer</RepositoryUrl>
    <RepositoryType>GitHub</RepositoryType>
    <PackageTags>mysql sql csharp postgresql database-connector</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
