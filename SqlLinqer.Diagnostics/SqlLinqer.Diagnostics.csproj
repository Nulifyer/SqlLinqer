<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Authors>Kyle Leddy</Authors>
    <Description>Optional ILogger and ActivitySource instrumentation for SqlLinqer.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>2.2.0-dev</Version>
    <RepositoryUrl>https://github.com/Nulifyer/SqlLinqer</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup><None Include="README.md" Pack="true" PackagePath="/" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../SqlLinqer/SQLLinqer.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.13" />
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>
</Project>
